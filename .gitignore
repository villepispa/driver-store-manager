# Local / generated working trees
audit-output/
backups/
*.log

# Ad-hoc pnputil CSV dumps at repo root
pnputil_*.csv

# Secrets / credentials
.env
.env.*

# OS / editor
Thumbs.db
.DS_Store
*.code-workspace

# Historical session exports (absorbed into living docs; keep local only)
docs/archive/

# Pre-change snapshots (PCB); keep local only
_archive/

# Ad-hoc drafts (may contain host paths)
scripts/_drafts/
tests/_drafts/

# Cursor agent / PM workspace state (not part of the product publish surface)
.cursor/

# Proton Drive conflict copies (CFG-158 / TERV-030). Example:
#   BACKLOG (# Edit conflict 2026-08-19 eqih1yC #).md
# Matcher is the distinctive "Edit conflict" token so gitignore `#`
# comments cannot truncate the pattern. Canonical file wins after a human check.
**/*Edit conflict*
